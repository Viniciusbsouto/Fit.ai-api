# Backend only. Never copy real credentials into this file or NEXT_PUBLIC_*.
NODE_ENV=development
PORT=8081
# Matches the existing local docker-compose (host port 5434).
DATABASE_URL=postgresql://postgres:password@localhost:5434/bootcamp-treinos-api
# Generate a random value of at least 32 characters. Keep the existing secret on deploy.
BETTER_AUTH_SECRET=
API_BASE_URL=http://localhost:8081
# Legacy alias is still accepted. If both are set, they must be identical.
# BETTER_AUTH_URL=http://localhost:8081
# Exact frontend origin; shared by CORS and Better Auth trustedOrigins.
WEB_APP_BASE_URL=http://localhost:3000

# Optional Google OAuth: configure BOTH values or leave BOTH empty.
# Google Console redirect URI: http://localhost:8081/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional shared parent domain for app.example.com and api.example.com.
# Required for frontend server rendering to receive sessions across subdomains.
# COOKIE_DOMAIN=.example.com

# TeamSocLo gateway: SDK appends /messages, so the base MUST include /v1.
# Uses Authorization: Bearer and anthropic-version: 2023-06-01.
# Model remains claude-haiku-4-5 in src/routes/ai.ts.
ANTHROPIC_BASE_URL=https://gpt.teamsoclo.site/v1
# Optional for boot; authenticated chat returns 503 until configured.
ANTHROPIC_AUTH_TOKEN=

# Production: NODE_ENV=production, explicit HTTPS API/WEB URLs,
# database reachable by the container, credentials injected at runtime.
# No OPENAI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY is required.
